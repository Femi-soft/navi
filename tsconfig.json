{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@navi/core": ["packages/core/src/index.ts"],
      "@navi/portfolio": ["packages/portfolio/src/index.ts"],
      "@navi/opportunities": ["packages/opportunities/src/index.ts"],
      "@navi/risk": ["packages/risk/src/index.ts"],
      "@navi/policy": ["packages/policy/src/index.ts"],
      "@navi/strategy": ["packages/strategy/src/index.ts"],
      "@navi/simulation": ["packages/simulation/src/index.ts"],
      "@navi/execution": ["packages/execution/src/index.ts"],
      "@navi/ai": ["packages/ai/src/index.ts"],
      "@navi/database": ["packages/database/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
