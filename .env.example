# Server-only. Never prefix these values with NEXT_PUBLIC_.
NAVI_NETWORK=testnet
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=
SIMULATION_ATTESTATION_SECRET=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DATABASE_URL=
LLM_PROVIDER=groq
GROQ_API_KEY=
# Free-tier testnet default. Provider credentials always remain server-only.
LLM_MODEL=openai/gpt-oss-20b
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_TIMEOUT_MS=20000
# Optional later OpenAI promotion; inactive while LLM_PROVIDER=groq.
LLM_API_KEY=
# Deployment/staging: X Layer testnet, chain ID 1952.
X_LAYER_TESTNET_RPC_URL=
# Production launch/live portfolio: X Layer mainnet, chain ID 196.
X_LAYER_RPC_URL=
# CoinGecko Simple Price endpoint must include ids=okb, vs_currencies=usd,
# and include_last_updated_at=true. Use api.coingecko.com for Demo keys or
# pro-api.coingecko.com for Pro keys.
PRICE_API_URL=https://api.coingecko.com/api/v3/simple/price?ids=okb&vs_currencies=usd&include_last_updated_at=true
# Optional for the low-volume keyless public tier in testnet mode; required for mainnet.
PRICE_API_KEY=
PRICE_MAX_AGE_SECONDS=180
DATA_PROVIDER_KEYS=

# Deployment remains disabled until contracts are audited and these values are
# explicitly approved. Never put a deployer key in a NEXT_PUBLIC_ variable.
DEPLOYER_PRIVATE_KEY=
NAVI_POLICY_MANAGER_ADDRESS=
NAVI_EXECUTOR_ADDRESS=
EXPECTED_EXECUTOR_OWNER=
CRON_SECRET=
MONITORING_WEBHOOK_URL=
RECEIPT_CONFIRMATIONS=2

# Public wallet metadata only. Never place the credentialed provider URL here.
NEXT_PUBLIC_X_LAYER_CHAIN_ID=1952
NEXT_PUBLIC_X_LAYER_WALLET_RPC_URL=https://testrpc.xlayer.tech/terigon
NEXT_PUBLIC_NAVI_EXECUTOR_ADDRESS=0xc019eD728d1A23C995bf7056de1BCc8d9DF32b1d
NEXT_PUBLIC_NAVI_POLICY_MANAGER_ADDRESS=0x86883d049b0A09d02Eeb056527e7a24522D89F23
